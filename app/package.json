{
  "name": "deepseek-local-client",
  "version": "1.0.0",
  "description": "DeepSeek V4 本地桌面客户端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "local.deepseek.client",
    "productName": "DeepSeek本地客户端",
    "directories": {
      "output": ".."
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "DeepSeek本地客户端.exe",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  }
}
